{
  "manifest_version": 3,
  "name": "LensQA Capture",
  "version": "0.1.0",
  "description": "One-click authenticated page capture drafts for LensQA projects",
  "action": {
    "default_title": "Capture for LensQA"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
